# Copy this file to .env and add your real key.
# Never commit .env or paste the key into index.html or client-side JavaScript.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional server settings.
PORT=8765
HOST=127.0.0.1
PUBLIC_SITE_URL=http://127.0.0.1:8765
CERT_COUNT=61
MAX_TOKENS=500
TEMPERATURE=0.4
RATE_LIMIT=30

